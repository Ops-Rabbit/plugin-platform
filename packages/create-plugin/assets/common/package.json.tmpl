{
  "name": "{{packageName}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{displayName}} OpsRabbit plugin",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": "^22.23.4 || ^24.22.1 || >=26.12.1" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "plugin:check": "opsrabbit-plugin check",
    "plugin:pack": "npm run build && opsrabbit-plugin pack",
    "plugin:release": "npm run build && opsrabbit-plugin release"
  },
  "dependencies": {
    "@opsrabbit/plugin-sdk": "{{sdkVersion}}"
  },
  "devDependencies": {
    "@opsrabbit/create-plugin": "^{{cliVersion}}",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
