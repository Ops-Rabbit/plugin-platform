import { createTestContext } from '@opsrabbit/plugin-sdk/testing';
import { describe, expect, it } from 'vitest';
import { plugin } from '../src/index.js';

describe('{{id}}', () => {
  it('uses opaque embedded authority without returning it', async () => {
    const context = createTestContext({
      embeddedChat: { widgetId: 'widget-a', externalUserId: 'external-a' },
      embeddedDelegationId: 'opaque-private-reference',
    });
    await expect(plugin.tools?.[0]?.run({}, context)).resolves.toEqual({
      kind: 'opsrabbit.tool-result/v1',
      text: 'The verified embedded session is active.',
      value: { widgetId: 'widget-a', active: true },
    });
    expect(JSON.stringify(context.logs)).not.toContain('opaque-private-reference');
  });

  it('rejects a normal or expired chat invocation', async () => {
    await expect(plugin.tools?.[0]?.run({}, createTestContext())).rejects.toThrow(
      'active verified embedded-chat turn',
    );
  });
});
