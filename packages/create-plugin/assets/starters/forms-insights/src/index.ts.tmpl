import {
  definePlugin,
  type DataInsightDashboardTemplateCatalog,
  type FormsAnalyticsCatalog,
  type JsonValue,
} from "@opsrabbit/plugin-sdk";

const analyticsCatalog = {
  schema_version: 1,
  metric_contract_version: "1.0.0",
  datasets: [
    {
      dataset_id: "insights.records",
      label: "Insight records",
      module_key: "insight_records",
      record_type: "insight_record",
      dimensions: [
        { field_key: "category", value_type: "text", sensitivity: "internal" },
        {
          field_key: "recorded_at",
          value_type: "timestamp",
          sensitivity: "internal",
        },
      ],
      measures: [
        { key: "record_count", aggregation: "count", unit: "records" },
        {
          key: "total_amount",
          field_key: "amount",
          aggregation: "sum",
          unit: "units",
        },
      ],
      default_time_field: "recorded_at",
    },
  ],
} satisfies FormsAnalyticsCatalog;

const templateCatalog = {
  schema_version: 1,
  templates: [
    {
      id: "records-overview",
      title: "Records overview",
      description: "Caller-visible record totals and category distribution.",
      suggested_questions: ["Which category has the most records?"],
      presentation: { show_date_range: true },
      authorization: {
        policy_key: "records_reviewer",
        label: "Records reviewer",
        description: "Can review the approved operational records dashboard.",
        references: {
          reports: ["records-overview"],
          metrics: ["record-count", "records-by-category"],
          saved_queries: ["records-by-category"],
        },
      },
      layout: { columns: 12 },
      queries: [
        {
          key: "record-count",
          dataset_id: "insights.records",
          name: "Record count",
          semantic_query: {
            dimensions: [],
            measures: ["record_count"],
            filters: [],
            limit: 1,
          },
          visualization_hint: "metric",
        },
        {
          key: "records-by-category",
          name: "Records by category",
          plugin_query: { saved_query_id: "records-by-category" },
          visualization_hint: "bar",
        },
      ],
      widgets: [
        {
          key: "record-total",
          type: "metric",
          title: "Records",
          query_key: "record-count",
          position: { x: 0, y: 0, w: 4, h: 2 },
        },
        {
          key: "category-chart",
          type: "bar",
          title: "Records by category",
          query_key: "records-by-category",
          config: { x_field: "category", value_field: "record_count" },
          position: { x: 0, y: 2, w: 8, h: 4 },
        },
      ],
    },
  ],
} satisfies DataInsightDashboardTemplateCatalog;

const availableSavedQueryIds = new Set(["records-by-category"]);
const availableReportIds = new Set(["records-overview"]);

export default definePlugin({
  actions: [
    {
      id: "run_insights_query",
      title: "Run Insights query",
      risk: "read",
      requiredRole: "viewer",
      async run(input: Record<string, JsonValue>, context) {
        const savedQueryId = String(input.saved_query_id ?? "");
        if (
          !availableSavedQueryIds.has(savedQueryId) ||
          !context.dataInsightAuthorization?.allowedReferences.saved_queries?.includes(
            savedQueryId,
          )
        ) {
          throw new Error("Saved query is not authorized for this dashboard.");
        }
        return { rows: [{ category: "Example", record_count: 1 }] };
      },
    },
    {
      id: "view_record_report",
      title: "View record report",
      risk: "read",
      requiredRole: "viewer",
      formPlacement: {
        moduleKey: "insight_records",
        recordType: "insight_record",
        intent: "primary",
      },
      dataInsightAuthorization: {
        namespace: "reports",
        inputField: "report_id",
      },
      async run(input: Record<string, JsonValue>, context) {
        const reportId = String(input.report_id ?? "");
        if (
          !availableReportIds.has(reportId) ||
          !context.dataInsightAuthorization?.allowedReferences.reports?.includes(
            reportId,
          )
        ) {
          throw new Error("Report is not authorized for this policy.");
        }
        return { report_id: reportId, rows: [] };
      },
    },
  ],
  routes: [
    {
      path: "/analytics-catalog",
      requiredRole: "viewer",
      async handle() {
        return analyticsCatalog as unknown as JsonValue;
      },
    },
    {
      path: "/analytics-templates",
      requiredRole: "viewer",
      async handle() {
        return templateCatalog as unknown as JsonValue;
      },
    },
  ],
});
