import { describe, expect, it } from "vitest";
import {
  validateDataInsightDashboardTemplateCatalog,
  validateFormsAnalyticsCatalog,
} from "@opsrabbit/plugin-sdk";
import { createTestContext } from "@opsrabbit/plugin-sdk/testing";
import plugin from "../src/index.js";

describe("{{displayName}}", () => {
  it("publishes a caller-scoped Forms analytics catalog", async () => {
    const catalog = await plugin.routes?.[0]?.handle({
      ...createTestContext({ tenantId: "tenant-a" }),
      path: "/analytics-catalog",
      query: {},
    });
    expect(catalog).toEqual(
      expect.objectContaining({
        schema_version: 1,
        datasets: [
          expect.objectContaining({
            dataset_id: "insights.records",
            module_key: "insight_records",
            record_type: "insight_record",
          }),
        ],
      }),
    );
    expect(validateFormsAnalyticsCatalog(catalog)).toEqual(
      expect.objectContaining({ ok: true, issues: [] }),
    );
  });

  it("publishes stable saved-query and widget references", async () => {
    const templates = await plugin.routes?.[1]?.handle({
      ...createTestContext({ tenantId: "tenant-a" }),
      path: "/analytics-templates",
      query: {},
    });
    expect(templates).toEqual(
      expect.objectContaining({
        schema_version: 1,
        templates: [
          expect.objectContaining({
            id: "records-overview",
            authorization: expect.objectContaining({
              policy_key: "records_reviewer",
              label: "Records reviewer",
              description:
                "Can review the approved operational records dashboard.",
              references: expect.objectContaining({
                metrics: ["record-count", "records-by-category"],
                saved_queries: ["records-by-category"],
              }),
            }),
            queries: expect.arrayContaining([
              expect.objectContaining({
                key: "records-by-category",
                plugin_query: { saved_query_id: "records-by-category" },
              }),
            ]),
            widgets: expect.arrayContaining([
              expect.objectContaining({
                key: "category-chart",
                query_key: "records-by-category",
                type: "bar",
              }),
            ]),
          }),
        ],
      }),
    );
    expect(validateDataInsightDashboardTemplateCatalog(templates)).toEqual(
      expect.objectContaining({ ok: true, issues: [] }),
    );
  });

  it("enforces host-attested references in plugin-native queries and governed actions", async () => {
    const context = createTestContext({
      tenantId: "tenant-a",
      dataInsightAuthorization: {
        schemaVersion: 1,
        mode: "resource_action",
        policyKey: "records_reviewer",
        dashboardId: "dashboard-a",
        subject: { type: "group", id: "group-a" },
        allowedReferences: {
          reports: ["records-overview"],
          saved_queries: ["records-by-category"],
        },
      },
    });
    await expect(
      plugin.actions?.[0]?.run(
        { saved_query_id: "records-by-category" },
        context,
      ),
    ).resolves.toEqual(expect.objectContaining({ rows: expect.any(Array) }));
    await expect(
      plugin.actions?.[1]?.run({ report_id: "records-overview" }, context),
    ).resolves.toEqual(
      expect.objectContaining({ report_id: "records-overview" }),
    );
    await expect(
      plugin.actions?.[0]?.run({ saved_query_id: "other" }, context),
    ).rejects.toThrow("not authorized");
    await expect(
      plugin.actions?.[1]?.run({ report_id: "other" }, context),
    ).rejects.toThrow("not authorized");
    const staleContext = createTestContext({
      tenantId: "tenant-a",
      dataInsightAuthorization: {
        ...context.dataInsightAuthorization!,
        allowedReferences: {
          reports: ["retired-report"],
          saved_queries: ["retired-query"],
        },
      },
    });
    await expect(
      plugin.actions?.[0]?.run(
        { saved_query_id: "retired-query" },
        staleContext,
      ),
    ).rejects.toThrow("not authorized");
    await expect(
      plugin.actions?.[1]?.run({ report_id: "retired-report" }, staleContext),
    ).rejects.toThrow("not authorized");
    const contextWithoutAuthorization = createTestContext({
      tenantId: "tenant-a",
    });
    await expect(
      plugin.actions?.[0]?.run(
        { saved_query_id: "records-by-category" },
        contextWithoutAuthorization,
      ),
    ).rejects.toThrow("not authorized");
    await expect(
      plugin.actions?.[1]?.run(
        { report_id: "records-overview" },
        contextWithoutAuthorization,
      ),
    ).rejects.toThrow("not authorized");
  });
});
