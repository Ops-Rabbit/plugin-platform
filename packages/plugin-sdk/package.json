{
  "name": "@opsrabbit/plugin-sdk",
  "version": "0.34.0",
  "description": "Public contracts, validation, and testing utilities for OpsRabbit plugins",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ops-Rabbit/plugin-platform.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/Ops-Rabbit/plugin-platform#readme",
  "bugs": "https://github.com/Ops-Rabbit/plugin-platform/issues",
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./packaging": {
      "types": "./dist/packaging/index.d.ts",
      "default": "./dist/packaging/index.js"
    },
    "./manifest-schema": "./schemas/opsrabbit-plugin.schema.json",
    "./channel-approval-decision-schema": "./schemas/opsrabbit-channel-approval-decision.schema.json",
    "./channel-approval-cleanup-schema": "./schemas/opsrabbit-channel-approval-cleanup.schema.json",
    "./structured-classification-request-schema": "./schemas/opsrabbit-structured-classification-request.schema.json",
    "./structured-classification-result-schema": "./schemas/opsrabbit-structured-classification-result.schema.json",
    "./form-starter-pack-schema": "./schemas/opsrabbit-form-starter-pack.schema.json",
    "./forms-analytics-catalog-schema": "./schemas/opsrabbit-forms-analytics-catalog.schema.json",
    "./data-insight-template-catalog-schema": "./schemas/opsrabbit-data-insight-template-catalog.schema.json",
    "./data-insight-authorization-context-schema": "./schemas/opsrabbit-data-insight-authorization-context.schema.json",
    "./channel-messaging-input-schema": "./schemas/opsrabbit-channel-messaging-input.schema.json",
    "./inbound-lifecycle-event-schema": "./schemas/opsrabbit-inbound-lifecycle-event.schema.json",
    "./plugin-resource-capability-schema": "./schemas/opsrabbit-plugin-resource-capability.schema.json",
    "./plugin-resource-deletion-schema": "./schemas/opsrabbit-plugin-resource-deletion.schema.json",
    "./plugin-resource-query-schema": "./schemas/opsrabbit-plugin-resource-query.schema.json",
    "./plugin-resource-registration-schema": "./schemas/opsrabbit-plugin-resource-registration.schema.json",
    "./plugin-resource-transaction-schema": "./schemas/opsrabbit-plugin-resource-transaction.schema.json",
    "./plugin-source-inbound-binding-schema": "./schemas/opsrabbit-plugin-source-inbound-binding.schema.json",
    "./structured-enrichment-input-schema": "./schemas/opsrabbit-structured-enrichment-input.schema.json",
    "./structured-enrichment-result-schema": "./schemas/opsrabbit-structured-enrichment-result.schema.json",
    "./plugin-inbound-registration-schema": "./schemas/opsrabbit-plugin-inbound-registration.schema.json",
    "./plugin-inbound-configuration-request-schema": "./schemas/opsrabbit-plugin-inbound-configuration-request.schema.json",
    "./plugin-inbound-configuration-schema": "./schemas/opsrabbit-plugin-inbound-configuration.schema.json",
    "./chat-turn-records-request-schema": "./schemas/opsrabbit-chat-turn-records-request.schema.json",
    "./chat-turn-records-result-schema": "./schemas/opsrabbit-chat-turn-records-result.schema.json",
    "./channel-messaging-reference-request-schema": "./schemas/opsrabbit-channel-messaging-reference-request.schema.json",
    "./channel-messaging-reference-result-schema": "./schemas/opsrabbit-channel-messaging-reference-result.schema.json"
  },
  "scripts": {
    "build": "node ../../scripts/clean-directory.mjs dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --no-file-parallelism"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
