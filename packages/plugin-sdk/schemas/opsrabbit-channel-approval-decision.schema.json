{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deliveryId",
    "externalConversationKey",
    "messageId",
    "botUserId",
    "actor",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "deliveryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "externalConversationKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "botUserId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "workspaceId", "userId", "displayName"],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,39}$"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$"
        },
        "userId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "decision": {
      "enum": ["allow-once", "deny"]
    }
  }
}
