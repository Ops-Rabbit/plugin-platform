{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["instanceId", "channelId", "text"],
  "properties": {
    "instanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
    },
    "channelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    }
  }
}
