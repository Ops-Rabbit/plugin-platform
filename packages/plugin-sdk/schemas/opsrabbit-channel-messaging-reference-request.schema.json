{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "channelId"],
      "properties": {
        "kind": {
          "const": "destination"
        },
        "channelId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "channelId", "messageId"],
      "properties": {
        "kind": {
          "const": "sent_message"
        },
        "channelId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
        }
      }
    }
  ]
}
