{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsrabbit.dev/schemas/opsrabbit-chat-turn-records-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["turnIds"],
  "properties": {
    "turnIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,160}$"
      }
    }
  }
}
