{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsrabbit.com/schemas/plugin-resource-deletion.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}(?![\\s\\S])"
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
      },
      "maxItems": 100,
      "minItems": 1,
      "uniqueItems": true
    },
    "reason": {
      "enum": [
        "retention",
        "manual",
        "tenant_deleted",
        "restore_reconciliation"
      ]
    }
  },
  "required": ["schemaVersion", "kind", "ids", "reason"]
}
