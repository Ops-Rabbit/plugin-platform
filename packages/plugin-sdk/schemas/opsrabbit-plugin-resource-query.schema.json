{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsrabbit.com/schemas/plugin-resource-query.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}(?![\\s\\S])"
    },
    "tenantIds": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
          },
          "maxItems": 100,
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sql": {
          "type": "string",
          "maxLength": 32768,
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 32768,
                "minLength": 0
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 128,
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": ["sql", "parameters"]
    },
    "orderBy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}(?![\\s\\S])"
          },
          "direction": {
            "enum": ["asc", "desc"]
          }
        },
        "required": ["column", "direction"]
      },
      "maxItems": 4,
      "minItems": 1,
      "uniqueItems": false
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "groupBy": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}(?![\\s\\S])"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "tenantIds",
    "candidates",
    "orderBy",
    "page",
    "pageSize"
  ]
}
