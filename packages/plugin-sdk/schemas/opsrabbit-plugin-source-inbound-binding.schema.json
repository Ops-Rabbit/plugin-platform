{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsrabbit.com/schemas/plugin-source-inbound-binding.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "inboundId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}(?![\\s\\S])"
    },
    "enabled": {
      "type": "boolean"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "expectedIncarnationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
    }
  },
  "required": ["inboundId", "kind", "enabled"]
}
