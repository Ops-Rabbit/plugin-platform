{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsrabbit.com/schemas/structured-enrichment-input.v1.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,79}(?![\\s\\S])"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,160}(?![\\s\\S])"
            }
          },
          "required": ["kind", "id"]
        },
        "title": {
          "type": "string",
          "maxLength": 2000,
          "minLength": 0
        },
        "description": {
          "type": "string",
          "maxLength": 32768,
          "minLength": 0
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "generateTitle": {
          "const": true
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,79}(?![\\s\\S])",
            "not": {
              "enum": [
                "tenant_id",
                "owner_user_id",
                "source_system_id",
                "event_id",
                "binding_revision",
                "revision",
                "resource_id",
                "source_title",
                "display_title",
                "title_provenance",
                "source_status",
                "investigation_status",
                "writeback_status",
                "correlation",
                "owner_id",
                "id",
                "incident_id",
                "source_event_id",
                "inbound_id",
                "upstream_incident_id",
                "thread_id",
                "turn_id",
                "grants",
                "permissions",
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "maxProperties": 64,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": ["text", "number", "boolean", "date"]
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 160,
                    "minLength": 1
                  }
                },
                "required": ["type", "label"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "enum"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 160,
                    "minLength": 1
                  },
                  "enumValues": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 160,
                      "minLength": 1
                    },
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true
                  }
                },
                "required": ["type", "label", "enumValues"]
              }
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "resource",
        "title",
        "description",
        "timeoutMs",
        "generateTitle",
        "fields"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
