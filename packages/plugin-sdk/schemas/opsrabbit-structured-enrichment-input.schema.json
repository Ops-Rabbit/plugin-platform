          "minLength": 0
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "generateTitle": {
          "const": false
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,79}(?![\\s\\S])",
            "not": {
              "enum": [
                "tenant_id",
                "owner_user_id",
